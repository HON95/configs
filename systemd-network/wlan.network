[Match]
Name=wlan*

[Network]
DHCP=yes
IPv6AcceptRA=yes
IPv6PrivacyExtensions=no
IgnoreCarrierLoss=5s
# no (disable), resolve (query only) or yes (resolve and answer)
MulticastDNS=resolve

[DHCPv4]
RouteMetric=2048
UseDNS=yes
UseNTP=no
UseHostname=no
UseDomains=yes
Anonymize=yes

[DHCPv6]
RouteMetric=2048
UseDNS=yes
UseNTP=no
UseHostname=no
UseDomains=yes

[IPv6AcceptRA]
RouteMetric=2048
UseDNS=yes
UseDomains=yes
Token=prefixstable
